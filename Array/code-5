#include<iostream>
using namespace std;

int linearsearch(int arr[], int size,int target){

    for(int i=0;i<size;i++)
    {
        if(arr[i]==target){
        return i;}
    }
    return -1;
}
 int main()
 {
    int arr[]={5,6,5,7,4,5,8};
    int size=7;
    int target = 17;
    cout << linearsearch(arr,size,target);

return 0;

}
