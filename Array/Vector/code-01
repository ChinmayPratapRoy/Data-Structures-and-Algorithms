AT (to find value at that index)

#include<iostream>
#include<vector>
using namespace std;
int main(){
    vector<char>nums ={'a','b','t'};

    cout << nums.size() <<endl;

       nums.pop_back();

        cout << nums.size() <<endl;
        cout << nums.at(0) << endl;

return (0);
}

