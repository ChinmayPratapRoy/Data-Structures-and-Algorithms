CAPACITY

#include<iostream>
#include<vector>
using namespace std;
int main(){
    vector<int>nums;

      nums.push_back(6);
      nums.push_back(8);
      nums.push_back(5);
      nums.push_back(2);
      nums.push_back(0);
     
       nums.pop_back();

        cout << nums.size() <<endl;
        cout << nums.capacity() << endl;

return (0);
}


