#include <iostream>
#include<vector>
using namespace std;
int binarysearch(vector<int>arr,int target){

    int st=0,end=arr.size();
    while(st<=end)
        {
      int  mid =(st+end)/2;
    if(target>arr[mid])
    {
       st = mid+1;
    }
   else if (target>arr[mid])
    {
     end = mid-1;
    }
            else{
                return mid;
            }
            }
    return -1;
}
int main()
{
vector<int>nums = {5,6,8,4,3,8};
 int target=4;
 cout <<binarysearch(nums,target);
   
    return 0;
}  
